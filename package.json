{
  "name": "obix-binding-python",
  "version": "0.5.0",
  "description": "OBIX Python Binding - ML/AI integration, data science workflows",
  "license": "MIT",
  "author": "OBINexus <okpalan@protonmail.com>",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "docs",
    "README.md",
    "LICENSE",
    "__tests__",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "obix"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obinexus/obix-binding-python.git"
  },
  "bugs": {
    "url": "https://github.com/obinexus/obix-binding-python/issues"
  },
  "homepage": "https://github.com/obinexus/obix-binding-python#readme"
}
